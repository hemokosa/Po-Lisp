; Po-Lisp で、ことばの手ざわりを確かめる。
;   examples/polisp_word/kotoba.lisp と同じことを、7文字で書いたもの
;   python3 polisp_min.py examples/polisp/kotoba.lisp

; 分ける            car < / cdr >
(<'(雪 が 降る))                    ; 雪
(>'(雪 が 降る))                    ; (が 降る)
(<(>'(雪 が 降る)))                 ; が

; 組み立てる        cons +
(+'雪(+'が(+'降る())))              ; (雪 が 降る)
(+'夜'(が 明ける))                  ; (夜 が 明ける)

; 入れ子にする
(+'(朝 の)'(光 が さす))            ; ((朝 の) 光 が さす)

; 問う              atom @ / eq =
(@'雪)                              ; t
(@'(雪 が 降る))                    ; ()
(@'())                              ; t
(='ゆき'ゆき)                       ; t
(='ゆき'あめ)                       ; ()

; えらぶ            cond ?
(?((@'(雪 が 降る))'ひとこと)
  ((=(<'(雪 が 降る))'雪)'ゆきのうた)
  (t'なにか))                       ; ゆきのうた

; 二番目の語を取り出す、を < と > で綴る
(<(>(>'(まだ 見ぬ 岸))))            ; 岸
