; はじまり
;   Po-Lisp で、無から読み手までを組み上げていく詩
;   python3 polisp.py examples/polisp/hajimari.lisp


; 一 ── 無
;   はじめに、括弧がふたつ。あいだには何もない。
()
;   何もないが、これ以上は割れない。
(@())


; 二 ── 名
;   ' をつけると、それは呼ばれずに、ただ在る。
'雪


; 三 ── むすぶ
;   ひとつを、無のまえに置く。
(+'雪())
;   もう一度置けば、列になる。
(+'雪'(が 降る))


; 四 ── ほどく
;   むすんだものは、頭と、残りに分かれる。
(<'(雪 が 降る))
(>'(雪 が 降る))


; 五 ── 問う
;   無かどうかを訊く言葉を、はじめて自分で名づける。
;   = はアトムしか比べないので、まず @ で守る。
:def 無か (\(x)(?((@x)(=x()))(t())))
(無か())
(無か'(雪))


; 六 ── えらぶ
;   問いがあれば、道は分かれる。
(?((無か'())'しずか)
  (t'ざわめき))


; 七 ── はたらき
;   名のないものにも、はたらきは持たせられる。
((\(x)(+x(+x())))'木)
;   それに名を与えれば、あとから何度でも呼べる。
:def 重ねる (\(x)(+x(+x())))
(重ねる'鳥)


; 八 ── 自分を呼ぶ
;   * は、まだ生まれていない自分の名を、先に呼ぶための印。
;   それだけで、言葉は終わりまで歩けるようになる。
:def つらねる (*f(\(x y)
  (?((無か x)y)
    (t(+(<x)(f(>x)y))))))
(つらねる'(雪 が)'(降る))

:def さかさ (*r(\(x)
  (?((無か x)())
    (t(つらねる(r(>x))(+(<x)()))))))
(さかさ'(海 へ 続く 道))


; 九 ── わたす
;   はたらきそのものを、引数として手わたす。
:def めぐる (*m(\(f xs)
  (?((無か xs)())
    (t(+(f(<xs))(m f(>xs)))))))
(めぐる 重ねる'(遠く 近く))
;   公理も値なので、そのまま渡せる。
(めぐる <'((白い 鳥)(黒い 水)))


; 十 ── 書きかえる
;   ひとつの語を、別の語に。奥のほうまで。
:def 置く (*s(\(新 旧 x)
  (?((@x)(?((=x 旧)新)(t x)))
    (t(めぐる(\(e)(s 新 旧 e))x)))))
(置く'雨'雪'(雪 が (雪 の 上に) 降る))


; 十一 ── 詩は、データでもある
;   走らせるための一行を、走らせずに、ただ持っておく。
:def 詩 '(+'雪(+'が(+'降る())))
詩
;   持っていたものを、いま読む。
(!詩)
;   読むまえに、書きかえてしまうこともできる。
(!(置く'雨'雪 詩))
;   もとの詩は、なくなっていない。
詩


; 十二 ── 読み手をつくる
;   ここまでの言葉だけで、読むという行いそのものを書く。
:def 芯     (\(x)(<(<x)))
:def 次     (\(x)(<(>x)))
:def 三つ目 (\(x)(<(>(>x))))
:def 芯の次 (\(x)(<(>(<x))))
:def 芯の三 (\(x)(<(>(>(<x)))))

;   名と値の対をならべた、覚え書き。
:def 対 (*p(\(名々 値々)
  (?((無か 名々)())
    (t(+(+(<名々)(+(<値々)()))(p(>名々)(>値々)))))))

;   覚え書きから、名を引く。
:def 名ひく (*a(\(名 覚え)
  (?((無か 覚え)())
    ((=名(芯 覚え))(芯の次 覚え))
    (t(a 名(>覚え))))))

;   節を順に見て、最初に真になったものを読む。
:def 節よむ (*c(\(節々 覚え)
  (?((よむ(芯 節々)覚え)(よむ(芯の次 節々)覚え))
    (t(c(>節々)覚え)))))

;   ならんだものを、ひとつずつ読む。
:def みな (*l(\(々 覚え)
  (?((無か 々)())
    (t(+(よむ(<々)覚え)(l(>々)覚え))))))

;   よむ。
:def よむ (\(式 覚え)
  (?((@式)(名ひく 式 覚え))
    ((@(<式))
     (?((=(<式)'')(次 式))
       ((=(<式)'@)(@(よむ(次 式)覚え)))
       ((=(<式)'=)(=(よむ(次 式)覚え)(よむ(三つ目 式)覚え)))
       ((=(<式)'<)(<(よむ(次 式)覚え)))
       ((=(<式)'>)(>(よむ(次 式)覚え)))
       ((=(<式)'+)(+(よむ(次 式)覚え)(よむ(三つ目 式)覚え)))
       ((=(<式)'?)(節よむ(>式)覚え))
       (t(よむ(+(名ひく(<式)覚え)(>式))覚え))))
    ((=(芯 式)'*)
     (よむ(+(芯の三 式)(>式))
       (+(+(芯の次 式)(+(<式)()))覚え)))
    ((=(芯 式)'\)
     (よむ(芯の三 式)
       (つらねる(対(芯の次 式)(みな(>式)覚え))覚え)))))

;   書かれた読み手が、はじめの一行を読みあげる。
(よむ 詩())
;   覚え書きに置いた語も、読める。
(よむ'(+ 雪'(が 降る))'((雪 雪)))
;   名のないものも、自分を呼ぶものも、読める。
(よむ'((\(x)(+x(+x())))'木)())
(よむ'((*f(\(x y)(?((@x)y)('t(+(<x)(f(>x)y))))))'(夜 が)'(明ける))())

;   同じ一行を、ふたりが読む。
(!詩)
(よむ 詩())
