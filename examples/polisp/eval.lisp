; eval を、Po-Lisp で書く。
;   評価器そのものは @ = < > + ? ' \ * だけでできている。
;   python3 polisp.py examples/polisp/eval.lisp
;   語で書いた同じものは examples/polisp_word/eval.lisp

; 先に、橋の ! を語の名前で捕まえておく（英数字やかなはデータ側に空いている）
:def もとのeval !

; --- 小さな道具。空判定は @ で守る（= はアトムしか比べない）
:def null   (\(x)(?((@x)(=x()))(t())))
:def cadr   (\(x)(<(>x)))
:def caddr  (\(x)(<(>(>x))))
:def caar   (\(x)(<(<x)))
:def cadar  (\(x)(<(>(<x))))
:def caddar (\(x)(<(>(>(<x)))))

:def append (*ap(\(x y)
  (?((null x)y)
    (t(+(<x)(ap(>x)y))))))

; 名前の並びと値の並びから、((名前 値) ...) をつくる
:def pair (*pr(\(ns vs)
  (?((null ns)())
    (t(+(+(<ns)(+(<vs)()))(pr(>ns)(>vs)))))))

:def assoc (*as(\(k al)
  (?((null al)())
    ((=k(caar al))(cadar al))
    (t(as k(>al))))))

; --- 評価器
:def evcon (*ec(\(c a)
  (?((!(caar c)a)(!(cadar c)a))
    (t(ec(>c)a)))))

:def evlis (*el(\(m a)
  (?((null m)())
    (t(+(!(<m)a)(el(>m)a))))))

; ここから下が eval そのもの。橋の ! を、自分で書いた ! で覆う
:def ! (\(e a)
  (?((@e)(assoc e a))
    ((@(<e))
     (?((=(<e)'')(cadr e))
       ((=(<e)'@)(@(!(cadr e)a)))
       ((=(<e)'=)(=(!(cadr e)a)(!(caddr e)a)))
       ((=(<e)'<)(<(!(cadr e)a)))
       ((=(<e)'>)(>(!(cadr e)a)))
       ((=(<e)'+)(+(!(cadr e)a)(!(caddr e)a)))
       ((=(<e)'?)(evcon(>e)a))
       (t(!(+(assoc(<e)a)(>e))a))))
    ((=(caar e)'*)
     (!(+(caddar e)(>e))
       (+(+(cadar e)(+(<e)()))a)))
    ((=(caar e)'\)
     (!(caddar e)
       (append(pair(cadar e)(evlis(>e)a))a)))))


; ------------------------------------------------------------------ 動かしてみる
(!'(<'(雪 が 降る))())                      ; 雪
(!'(+x'(が 降る))'((x 雪)))                 ; (雪 が 降る)
(!'(?((@x)'ひとつ)('t'いくつも))
  '((x(朝 と 夜))))                          ; いくつも

(!'((\(x y)(+x(>y)))'朝'(夜 が 明ける))())  ; (朝 が 明ける)
(!'(ふたつ'木)'((ふたつ(\(x)(+x(+x()))))))  ; (木 木)

(!'((*ap(\(x y)
       (?((@x)y)
         ('t(+(<x)(ap(>x)y))))))
     '(雪 が)'(降る))
  ())                                        ; (雪 が 降る)

(もとのeval'(<'(雪 が 降る)))               ; 雪  ── 言語じたいの評価器
(もとのeval'(!'(<'(雪 が 降る))()))         ; 雪  ── 橋が、書いた評価器を呼ぶ


; --------------------------------------------- 詩をデータとして書き換えて、走らせる
:def mapcar (*mc(\(f xs)
  (?((null xs)())
    (t(+(f(<xs))(mc f(>xs)))))))

:def 置く (*sub(\(新 旧 x)
  (?((@x)(?((=x 旧)新)(t x)))
    (t(mapcar(\(e)(sub 新 旧 e))x)))))

:def 詩 '(+'雪(+'が(+'降る())))

(!詩())                                      ; (雪 が 降る)
(!(置く'雨'雪 詩)())                         ; (雨 が 降る)
(!(置く'止む'降る(置く'雨'雪 詩))())         ; (雨 が 止む)
詩                                           ; もとの詩はそのまま
