; 絵文字
;   構文は11の記号が引き受けるので、絵文字もそのまま名前になる。
;   python3 polisp.py examples/polisp/emoji.lisp


; 一 ── 名として
;   かなや漢字と同じように、絵文字もひとつのアトム。
'🌸
(@'🌸)
(='🌸'🌸)
(='🌸'🌺)


; 二 ── 列として
;   ひとつを、無のまえに置く。空白は記号の隣でだけ要らない。
(+'🌸'(が 咲く))
(+'🌙(+'と(+'🌊())))
(<'(🐦 が 渡る))
(>'(🐦 が 渡る))


; 三 ── 組み合わせでできた絵文字も、ひとつ
;   肌の色、家族、国旗、キーキャップ。符号位置はいくつあっても、名前はひとつ。
(+'👩🏽‍🚀(+'👨‍👩‍👧(+'🇯🇵(+'1️⃣()))))
(@'👨‍👩‍👧)
(='👩🏽‍🚀'👩🏽‍🚀)


; 四 ── 区切りは空白だけ
;   記号の隣では空白が要らない、ということは、絵文字どうしは切れないということ。
'🌸🍃
(@'🌸🍃)
;   分けたいなら、空白を置く。
'(🌸 🍃)


; 五 ── 見た目が同じでも
;   ❄️ は ❄ のうしろに異体字セレクタがついたもの。文字として違うから、別の名前。
(='❄️'❄)
(='❄️'❄️)


; 六 ── はたらきに渡す
;   絵文字は値なので、名のない関数にも、そのまま渡せる。
((\(x)(+x(+x())))'🐦)
:def 咲かせる (\(x)(+x'(が 咲く)))
(咲かせる'🌸)
(咲かせる'🌻)


; 七 ── 置きかえる
;   語を絵文字に替える。詩はデータなので、書き換えてから読める。
:def めぐる (*m(\(f xs)
  (?((@xs)())
    (t(+(f(<xs))(m f(>xs)))))))
:def 絵にする (\(w)
  (?((='雪 w)'❄️)
    ((='花 w)'🌸)
    ((='鳥 w)'🐦)
    (t w)))
(めぐる 絵にする'(雪 と 花 と 鳥))


; 八 ── 詩として
;   書き換えた列を、そのまま式にして読ませる。
:def 詩 '(+'🌸(+'が(+'咲く())))
詩
(!詩)
