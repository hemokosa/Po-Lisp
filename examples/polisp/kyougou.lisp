; 競合 ── ひとつの語に、ふたつの次
;   「自律」（jiritsu.lisp）では、関係はひとつだった。だから個体もひとつに決まった。
;   関係がふたつあると、語は次を選べてしまう。選べるということは、決まらないということ。
;   どちらが正しいかは、この詩の中では決まらない。決まらないまま、個体は立つ。
;   python3 polisp.py examples/polisp/kyougou.lisp


; 一 ── ふたつの関係
;   同じ語彙に、ちがう隣接を与える。語はひとつも足していない。
:def 甲 '((記号 名)(名 式)(式 評価)(評価 値)(値 詩)(引用 評価))
:def 乙 '((記号 名)(名 引用)(引用 式)(式 記号)(評価 詩)(値 名))
:def つづき (*a(\(w r)
  (?((@r)())
    ((=(<(<r))w)(<(>(<r))))
    (t(a w(>r))))))
(つづき'記号 甲)
(つづき'記号 乙)
;   応え　名 と 名。
;   はじめの一歩は、どちらも同じ。競合は、まだ見えていない。


; 二 ── 分かれる
;   問い　「名」の次は。
(つづき'名 甲)
(つづき'名 乙)
;   応え　式 と 引用。
;   ここで道が割れる。語の側には、どちらを選ぶ理由がない。


; 三 ── 戻ってくる関係
;   乙は、式から記号へ帰る。たどりつづければ、同じ語をもう一度踏む。
;   だから、来た道を覚えておき、踏んだら閉じることにする。
:def 見たか (*m(\(w xs)
  (?((@xs)())
    ((=(<xs)w)t)
    (t(m w(>xs))))))
:def たどる (*c(\(w r 履)
  (?((見たか w 履)())
    ((=(つづき w r)())(+w()))
    (t(+w(c(つづき w r)r(+w 履)))))))
:def つらねる (\(w r)(たどる w r()))
(つらねる'記号 甲)
(つらねる'記号 乙)
;   応え　(記号 名 式 評価 値 詩) と (記号 名 引用 式)。
;   甲は、次を持たない語に行きついて閉じる。
;   乙は、自分の始まりに帰ってきて閉じる。閉じ方まで、ふたつある。


; 四 ── 重ねる
;   両方を一本につなぐ。同じ語に二つの対があれば、先に置かれた方が引かれる。
:def つなぐ (*p(\(xs ys)
  (?((@xs)ys)
    (t(+(<xs)(p(>xs)ys))))))
(つらねる'記号(つなぐ 甲 乙))
(つらねる'記号(つなぐ 乙 甲))
;   応え　(記号 名 式 評価 値 詩) と (記号 名 引用 式)。
;   重ねても、混ざらない。あとから置かれた対は、引かれないまま残っている。
;   共存ではなく、隠蔽。そして順序が、どちらを隠すかを決めている。


; 五 ── 交互に読む
;   一歩ごとに、関係を持ちかえる。どちらにも従い、どちらにも従いきらない。
:def 交わる (*x(\(w r s 履)
  (?((見たか w 履)())
    ((=(つづき w r)())(+w()))
    (t(+w(x(つづき w r)s r(+w 履)))))))
:def 交互 (\(w r s)(交わる w r s()))
(交互'記号 甲 乙)
(交互'記号 乙 甲)
;   応え　(記号 名 引用 評価 詩) と (記号 名 式)。
;   どちらから始めるかで、別の個体になる。
;   甲から始めれば詩に届き、乙から始めれば三語で自分に戻る。


; 六 ── 分かれ目を数える
;   どの語が、ふたつの次を持っているのか。詩に、自分の割れ目を数えさせる。
:def 分かれ目 (*f(\(r)
  (?((@r)())
    ((=(つづき(<(<r))乙)())(f(>r)))
    ((=(つづき(<(<r))甲)(つづき(<(<r))乙))(f(>r)))
    (t(+(<(<r))(f(>r)))))))
(分かれ目 甲)
;   応え　(名 式 評価 値 引用)。
;   六語のうち五語が割れている。一致しているのは「記号」だけ。
;   はじまりだけが共有され、あとはすべて争点になっている。


; 七 ── どちらでもある語
;   ふたつの個体に、両方あらわれる語をとる。
:def 交わり (*i(\(xs ys)
  (?((@xs)())
    ((見たか(<xs)ys)(+(<xs)(i(>xs)ys)))
    (t(i(>xs)ys)))))
(交わり(つらねる'記号 甲)(つらねる'記号 乙))
;   応え　(記号 名 式)。
;   三語は、どちらの個体にも属している。ただし同じ位置にではない。


; 八 ── 位置は、ちがう
;   甲では三番目、乙では四番目。同じ語が、ちがう時に来る。
(<(>(>(つらねる'記号 甲))))
(<(>(>(つらねる'記号 乙))))
(<(>(>(>(つらねる'記号 乙)))))
;   応え　式 と 引用 と 式。
;   語がどこにいるかは、語ではなく、そこまでの関係が決めている。


; 九 ── 決着はつかない
;   問い　ふたつの個体は、同じか。どちらかが、もう一方を含むか。
:def 同じか (*e(\(x y)
  (?((@x)(?((@y)(=x y))(t())))
    ((@y)())
    ((e(<x)(<y))(e(>x)(>y)))
    (t()))))
(同じか(つらねる'記号 甲)(つらねる'記号 乙))
(見たか'詩(つらねる'記号 乙))
(見たか'引用(つらねる'記号 甲))
;   応え　()、()、()。
;   同じでもなく、どちらかが他方を抱えてもいない。
;   甲に引用はなく、乙に詩はない。争いは、勝ち負けの形をしていない。


; 十 ── 読むたびに、選ばれる
;   式はひとつ。どちらの関係のもとで読むかだけを、そのつど渡す。
(!'(つらねる'記号 関係)'((関係 ((記号 名)(名 式)(式 評価)(評価 値)(値 詩)(引用 評価)))))
(!'(つらねる'記号 関係)'((関係 ((記号 名)(名 引用)(引用 式)(式 記号)(評価 詩)(値 名)))))
;   応え　(記号 名 式 評価 値 詩) と (記号 名 引用 式)。
;   選択は詩の中にはない。読みのたびに、外から一度だけ置かれる。


; 十一 ── 割れたまま
;   問い　つないでしまえば、関係はひとつになるか。
(つづき'名(つなぐ 甲 乙))
(つづき'名(つなぐ 乙 甲))
(分かれ目 乙)
;   応え　式 と 引用 と (名 引用 式 評価 値)。
;   同じ語に同じ問いをしても、つないだ順で答えが変わる。
;   割れ目は、乙の側から数えても五つ。隠れただけで、消えてはいない。
;   ふたつの関係を持つ詩は、どちらで読むかという問いを抱えたまま在る。
;   その問いが、この詩の個体としての形になっている。
