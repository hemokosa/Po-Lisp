; 7つの公理だけで言葉をあつかう ── 手ざわりを確かめるための小片

; 分ける
(car '(雪 が 降る))                 ; 雪
(cdr '(雪 が 降る))                 ; (が 降る)
(car (cdr '(雪 が 降る)))           ; が

; 組み立てる
(cons '雪 (cons 'が (cons '降る '())))   ; (雪 が 降る)
(cons '夜 '(が 明ける))                  ; (夜 が 明ける)

; 入れ子にする ── リストの中のリスト
(cons '(朝 の) '(光 が さす))       ; ((朝 の) 光 が さす)

; 問う
(atom '雪)                          ; t
(atom '(雪 が 降る))                ; ()
(atom '())                          ; t   空リストはアトムでもある
(eq 'ゆき 'ゆき)                    ; t
(eq 'ゆき 'あめ)                    ; ()

; 選ぶ ── () だけが偽、それ以外はすべて真
(cond ((atom '(雪 が 降る)) 'ひとこと)
      ((eq (car '(雪 が 降る)) '雪) 'ゆきのうた)
      (t                            'なにか))   ; ゆきのうた

; 二番目の語を取り出す、を car と cdr で綴る
(car (cdr (cdr '(まだ 見ぬ 岸))))   ; 岸
